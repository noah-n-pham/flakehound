# Copy to .env for local development. Real values live in AWS Secrets Manager.
APP_ENV=local
LOG_LEVEL=info

# Matches docker-compose.yml (host port 5433 to avoid clashing with a local Postgres).
DATABASE_URL=postgresql+psycopg://ci:ci@localhost:5433/flakehound

# Any random string locally (`openssl rand -hex 32`). Tests sign their own
# payloads with it. In production this is the GitHub App's webhook secret, read
# from Secrets Manager, and it must match the App's setting byte for byte.
GITHUB_WEBHOOK_SECRET=

# You generate this one: `openssl rand -hex 32`. It gates every read endpoint and
# must be byte-identical here, in AWS Secrets Manager, and in the frontend's
# environment, or the dashboard gets 401 on every request.
INTERNAL_API_TOKEN=

# Where the frontend's BFF looks for the API. `cd frontend && npm run dev:local`
# reads this file, so the token exists in one place on the machine.
API_BASE_URL=https://api.flakehound.com

# The GitHub App. Point the path at the .pem you downloaded; never commit it.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# Whose installation token reads public repos for the observational board (D-046).
# Not a secret: an installation id. The crawl refuses to start without it.
OBSERVATION_INSTALLATION_ID=
