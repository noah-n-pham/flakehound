# Copy to .env for local development. Real values live in AWS Secrets Manager.
APP_ENV=local
LOG_LEVEL=info

# Matches docker-compose.yml (host port 5433 to avoid clashing with a local Postgres).
DATABASE_URL=postgresql+psycopg://ci:ci@localhost:5433/flakehound

# Any random string locally (`openssl rand -hex 32`) — tests sign their own
# payloads with it. In production this is GitHub's webhook secret from H-003,
# read from Secrets Manager, and it must match the App's setting byte for byte.
GITHUB_WEBHOOK_SECRET=

# H-004. You generate this one: `openssl rand -hex 32`. It gates every read
# endpoint and must be byte-identical here, in AWS Secrets Manager, and in
# Vercel's environment, or the dashboard gets 401 on every request.
INTERNAL_API_TOKEN=

# Where the frontend's BFF looks for the API. `cd frontend && npm run dev:local`
# reads this file, so the token exists in one place on the machine.
API_BASE_URL=https://api.flakehound.com

# The GitHub App. Point the path at the .pem you downloaded (H-012); never commit it.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
