# The BFF's variables. None is NEXT_PUBLIC_: the tokens must never reach the
# browser, which only ever talks to Next.js.
#
# Locally, `npm run dev:local` loads the repo-root .env instead, so the secrets
# exist in exactly one file on this machine.
API_BASE_URL=https://api.flakehound.com
INTERNAL_API_TOKEN=

# GitHub login. The client id and secret belong to the GitHub App, not to
# a separate OAuth app — the same App that signs webhooks. AUTH_SECRET signs the
# session cookie; Auth.js reads it by that name without being told.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_SECRET=
