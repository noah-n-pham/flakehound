# The BFF's two variables. Neither is NEXT_PUBLIC_: the token must never reach
# the browser, which only ever talks to Next.js.
#
# Locally, `npm run dev:local` loads the repo-root .env instead, so the internal
# token exists in exactly one file on this machine.
API_BASE_URL=https://api.flakehound.com
INTERNAL_API_TOKEN=
